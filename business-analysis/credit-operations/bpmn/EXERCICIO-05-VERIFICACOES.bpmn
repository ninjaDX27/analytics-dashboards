<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Exercise05" targetNamespace="https://portfolio.example/business-analysis/credit-operations" exporter="Business Analysis Training">
<bpmn:collaboration id="Collaboration_Exercise05"><bpmn:participant id="Participant_Intermediario" name="Intermediário de Crédito" processRef="Process_Exercise05"/><bpmn:participant id="Participant_Banco" name="Banco (black-box)"/><bpmn:messageFlow id="MessageFlow_Submissao" name="Dossiê submetido" sourceRef="Task_Submit" targetRef="Participant_Banco"/></bpmn:collaboration>
<bpmn:process id="Process_Exercise05" name="Verificação de identidade, rendimentos e IRS condicional" isExecutable="false"><bpmn:laneSet id="LaneSet_Exercise05">
<bpmn:lane id="Lane_Gestao" name="Gestão do processo"><bpmn:flowNodeRef>Start_Received</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_RetryJoin</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AndSplit</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AndJoin</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AllValid</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Submitted</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Correction</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Correctable</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Closed</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Identidade" name="Validação de identidade"><bpmn:flowNodeRef>Task_ID</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_Rendimentos" name="Validação financeira"><bpmn:flowNodeRef>Task_Income</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_SelfEmployed</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_IRS</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_IrsMerge</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start_Received" name="Dossiê recebido"><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="Gateway_RetryJoin" name="Início / nova tentativa"><bpmn:incoming>F01</bpmn:incoming><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:parallelGateway id="Gateway_AndSplit" name="Iniciar verificações"><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing><bpmn:outgoing>F04</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:userTask id="Task_ID" name="Verificar identidade e registar resultado"><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F05</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="Task_Income" name="Verificar rendimentos e registar resultado"><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F06</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Gateway_SelfEmployed" name="Trabalhador independente?" default="F08"><bpmn:incoming>F06</bpmn:incoming><bpmn:outgoing>F07</bpmn:outgoing><bpmn:outgoing>F08</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Task_IRS" name="Verificar IRS e registar resultado"><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Gateway_IrsMerge" name="Unir alternativas IRS"><bpmn:incoming>F08</bpmn:incoming><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:parallelGateway id="Gateway_AndJoin" name="Sincronizar verificações"><bpmn:incoming>F05</bpmn:incoming><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:exclusiveGateway id="Gateway_AllValid" name="Tudo válido?" default="F13"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="Task_Submit" name="Submeter dossiê ao banco"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="End_Submitted" name="Submissão efetuada"><bpmn:incoming>F17</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="Task_Correction" name="Solicitar correções documentais"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Gateway_Correctable" name="Correção possível?" default="F16"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="End_Closed" name="Encerrado sem submissão"><bpmn:incoming>F16</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F01" sourceRef="Start_Received" targetRef="Gateway_RetryJoin"/>
<bpmn:sequenceFlow id="F02" sourceRef="Gateway_RetryJoin" targetRef="Gateway_AndSplit"/>
<bpmn:sequenceFlow id="F03" sourceRef="Gateway_AndSplit" targetRef="Task_ID" name="Identidade"/>
<bpmn:sequenceFlow id="F04" sourceRef="Gateway_AndSplit" targetRef="Task_Income" name="Rendimentos"/>
<bpmn:sequenceFlow id="F05" sourceRef="Task_ID" targetRef="Gateway_AndJoin"/>
<bpmn:sequenceFlow id="F06" sourceRef="Task_Income" targetRef="Gateway_SelfEmployed"/>
<bpmn:sequenceFlow id="F07" sourceRef="Gateway_SelfEmployed" targetRef="Task_IRS" name="Sim"/>
<bpmn:sequenceFlow id="F08" sourceRef="Gateway_SelfEmployed" targetRef="Gateway_IrsMerge" name="Não"/>
<bpmn:sequenceFlow id="F09" sourceRef="Task_IRS" targetRef="Gateway_IrsMerge"/>
<bpmn:sequenceFlow id="F10" sourceRef="Gateway_IrsMerge" targetRef="Gateway_AndJoin"/>
<bpmn:sequenceFlow id="F11" sourceRef="Gateway_AndJoin" targetRef="Gateway_AllValid"/>
<bpmn:sequenceFlow id="F12" sourceRef="Gateway_AllValid" targetRef="Task_Submit" name="Sim"/>
<bpmn:sequenceFlow id="F13" sourceRef="Gateway_AllValid" targetRef="Task_Correction" name="Não"/>
<bpmn:sequenceFlow id="F14" sourceRef="Task_Correction" targetRef="Gateway_Correctable"/>
<bpmn:sequenceFlow id="F15" sourceRef="Gateway_Correctable" targetRef="Gateway_RetryJoin" name="Sim"/>
<bpmn:sequenceFlow id="F16" sourceRef="Gateway_Correctable" targetRef="End_Closed" name="Não"/>
<bpmn:sequenceFlow id="F17" sourceRef="Task_Submit" targetRef="End_Submitted"/>
</bpmn:process>
