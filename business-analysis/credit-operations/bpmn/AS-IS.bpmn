      <bpmndi:BPMNShape id="A_AttemptsGate_di" bpmnElement="A_AttemptsGate" isMarkerVisible="true">
        <dc:Bounds x="1190" y="440" width="52" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Lost_di" bpmnElement="A_Lost">
        <dc:Bounds x="1365" y="448" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Triage_di" bpmnElement="A_Triage">
        <dc:Bounds x="1020" y="510" width="145" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_RequestDocs_di" bpmnElement="A_RequestDocs">
        <dc:Bounds x="1195" y="510" width="145" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_CheckDocs_di" bpmnElement="A_CheckDocs">
        <dc:Bounds x="1370" y="510" width="145" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_DocsGate_di" bpmnElement="A_DocsGate" isMarkerVisible="true">
        <dc:Bounds x="1540" y="520" width="52" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_RemindDocs_di" bpmnElement="A_RemindDocs">
        <dc:Bounds x="1710" y="640" width="145" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Validate_di" bpmnElement="A_Validate">
        <dc:Bounds x="1710" y="500" width="145" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_ValidGate_di" bpmnElement="A_ValidGate" isMarkerVisible="true">
        <dc:Bounds x="1880" y="520" width="52" height="52" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Submit_di" bpmnElement="A_Submit">
        <dc:Bounds x="2050" y="640" width="145" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Receive_di" bpmnElement="A_Receive">
        <dc:Bounds x="2220" y="640" width="145" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Notify_di" bpmnElement="A_Notify">
        <dc:Bounds x="2400" y="510" width="145" height="74" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_End_di" bpmnElement="A_End">
        <dc:Bounds x="2595" y="528" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ASIS_01_di" bpmnElement="Flow_ASIS_01">
        <di:waypoint x="256" y="268" />
